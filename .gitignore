# Кэш шрифтов для витрины: скачивается автоматически при сборке
# (tools/build-share-preview.py), в репозитории не нужен.
tools/.fonts-cache/

# Промежуточный вариант витрины без <html>/<head>/<body> — нужен только
# при публикации на хостинге, который оборачивает содержимое сам.
# Пересобирается тем же скриптом.
share-preview.body.html
